# 17. CAB UPPER SHAPE
# ============================================================

def create_cab_upper(
    name,
    length,
    width,
    height,
    location,
    material,
    parent
):

    x1 = -length / 2
    x2 = length / 2

    y1 = -width / 2
    y2 = width / 2

    z1 = -height / 2
    z2 = height / 2


    front_top = (
        x2 - 0.20
    )


    verts = [

        (x1, y1, z1),
        (x1, y2, z1),

        (x2, y1, z1),
        (x2, y2, z1),

        (x1, y1, z2),
        (x1, y2, z2),

        (front_top, y1, z2),
        (front_top, y2, z2)
    ]


    faces = [

        (0, 2, 3, 1),

        (0, 1, 5, 4),

        (1, 3, 7, 5),

        (0, 4, 6, 2),

        (4, 5, 7, 6),

        (2, 6, 7, 3)
    ]


    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )


    mesh.from_pydata(
        verts,
        [],
        faces
    )


    mesh.update()


    obj = bpy.data.objects.new(
        name,
        mesh
    )


    COL_BODY.objects.link(
        obj
    )


    obj.parent = parent

    obj.location = location


    obj.data.materials.append(
        material
    )


    add_bevel(
        obj,
        0.035,
        2
    )


    return obj


# ============================================================
# 18. CYLINDER BETWEEN
# ============================================================

def cylinder_between_local(
    name,
    p1,
    p2,
    radius,
    material,
    parent,
    collection
):

    p1 = Vector(p1)

    p2 = Vector(p2)


    direction = (
        p2 - p1
    )


    length = (
        direction.length
    )


    centre = (
        p1 + p2
    ) / 2


    bpy.ops.mesh.primitive_cylinder_add(
        vertices=20,
        radius=radius,
        depth=length,
        location=(0, 0, 0)
    )


    obj = bpy.context.object

    obj.name = name

    obj.parent = parent

    obj.location = centre


    obj.rotation_euler = (
        direction.to_track_quat(
            'Z',
            'Y'
        ).to_euler()
    )


    obj.data.materials.append(
        material
    )


    move_to_collection(
        obj,
        collection
    )


    return obj


