def set_bsdf(
    bsdf,
    names,
    value
):

    for name in names:

        if name in bsdf.inputs:

            bsdf.inputs[name].default_value = value
            return True

    return False


def create_material(
    name,
    colour,
    metallic=0.0,
    roughness=0.5,
    transmission=0.0
):

    mat = bpy.data.materials.get(
        name
    )


    if mat is None:

        mat = bpy.data.materials.new(
            name=name
        )


    mat.use_nodes = True


    bsdf = mat.node_tree.nodes.get(
        "Principled BSDF"
    )


    if bsdf:

        set_bsdf(
            bsdf,
            ["Base Color"],
            (
                colour[0],
                colour[1],
                colour[2],
                1.0
            )
        )


        set_bsdf(
            bsdf,
            ["Metallic"],
            metallic
        )


        set_bsdf(
            bsdf,
            ["Roughness"],
            roughness
        )


        set_bsdf(
            bsdf,
            [
                "Transmission Weight",
                "Transmission"
            ],
            transmission
        )


        set_bsdf(
            bsdf,
            ["IOR"],
            1.45
        )


    mat.diffuse_color = (
        colour[0],
        colour[1],
        colour[2],
        1.0
    )


    return mat


