def create_logo_material(
    image_path
):

    if not os.path.exists(
        image_path
    ):

        print(
            "WARNING: FABCON logo file not found:"
        )

        print(
            image_path
        )

        return None


    mat_name = (
        "FABCON_LOGO_MATERIAL"
    )


    old_mat = bpy.data.materials.get(
        mat_name
    )


    if old_mat:

        bpy.data.materials.remove(
            old_mat,
            do_unlink=True
        )


    mat = bpy.data.materials.new(
        name=mat_name
    )


    mat.use_nodes = True


    nodes = mat.node_tree.nodes

    links = mat.node_tree.links


    nodes.clear()


    output = nodes.new(
        "ShaderNodeOutputMaterial"
    )


    output.location = (
        500,
        0
    )


    bsdf = nodes.new(
        "ShaderNodeBsdfPrincipled"
    )


    bsdf.location = (
        200,
        0
    )


    tex = nodes.new(
        "ShaderNodeTexImage"
    )


    tex.location = (
        -220,
        0
    )


    image = bpy.data.images.load(
        image_path,
        check_existing=True
    )


    tex.image = image


    links.new(
        tex.outputs["Color"],
        bsdf.inputs["Base Color"]
    )


    if (
        "Alpha" in tex.outputs
        and
        "Alpha" in bsdf.inputs
    ):

        links.new(
            tex.outputs["Alpha"],
            bsdf.inputs["Alpha"]
        )


    if "Roughness" in bsdf.inputs:

        bsdf.inputs[
            "Roughness"
        ].default_value = 0.38


    links.new(
        bsdf.outputs["BSDF"],
        output.inputs["Surface"]
    )


    try:

        mat.surface_render_method = (
            'DITHERED'
        )

    except:
        pass


    return mat


# ============================================================
# 60. CREATE CORRECT ORIENTED LOGO DECAL
#
# side = +1 -> +Y side
# side = -1 -> -Y side
#
# UV is reversed where required so FABCON text
# does NOT appear mirrored.
# ============================================================

def create_logo_decal(
    name,
    x,
    y,
    z,
    width,
    height,
    side,
    material
):

    hw = width / 2
    hh = height / 2


    if side > 0:

        # +Y side
        # UV horizontally reversed to avoid mirrored text

        vertices = [

            (-hw, 0, -hh),
            ( hw, 0, -hh),
            ( hw, 0,  hh),
            (-hw, 0,  hh)

        ]


        faces = [
            (0, 3, 2, 1)
        ]


        uv_coords = [

            (1, 0),
            (0, 0),
            (0, 1),
            (1, 1)

        ]


    else:

        # -Y side

        vertices = [

            (-hw, 0, -hh),
            ( hw, 0, -hh),
            ( hw, 0,  hh),
            (-hw, 0,  hh)

        ]


        faces = [
            (0, 1, 2, 3)
        ]


        uv_coords = [

            (0, 0),
            (1, 0),
            (1, 1),
            (0, 1)

        ]


    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )


    mesh.from_pydata(
        vertices,
        [],
        faces
    )


    mesh.update()


    # UV map

    uv_layer = mesh.uv_layers.new(
        name="UVMap"
    )


    for polygon in mesh.polygons:

        for loop_index in polygon.loop_indices:

            vertex_index = (
                mesh.loops[
                    loop_index
                ].vertex_index
            )


            uv_layer.data[
                loop_index
            ].uv = uv_coords[
                vertex_index
            ]


    obj = bpy.data.objects.new(
        name,
        mesh
    )


    COL_LOGOS.objects.link(
        obj
    )


    obj.parent = TRUCK_MASTER


    obj.location = (
        x,
        y,
        z
    )


    obj.data.materials.append(
        material
    )


    return obj


