def move_to_collection(
    obj,
    collection
):

    for old in list(
        obj.users_collection
    ):

        old.objects.unlink(
            obj
        )

    collection.objects.link(
        obj
    )


# ============================================================
# 12. BEVEL
# ============================================================

def add_bevel(
    obj,
    width=0.025,
    segments=2
):

    mod = obj.modifiers.new(
        name="Truck Edge Bevel",
        type='BEVEL'
    )

    mod.width = width

    mod.segments = segments


    try:

        mod.limit_method = (
            'ANGLE'
        )

    except:
        pass


