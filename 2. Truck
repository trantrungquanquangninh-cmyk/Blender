# 13. BOX
# ============================================================

def box_local(
    name,
    dimensions,
    location,
    material,
    parent,
    collection,
    rotation=(0, 0, 0),
    bevel=0.0
):

    bpy.ops.mesh.primitive_cube_add(
        location=(0, 0, 0)
    )


    obj = bpy.context.object

    obj.name = name

    obj.dimensions = dimensions


    bpy.ops.object.transform_apply(
        location=False,
        rotation=False,
        scale=True
    )


    obj.parent = parent

    obj.location = location

    obj.rotation_euler = rotation


    if material:

        obj.data.materials.append(
            material
        )


    move_to_collection(
        obj,
        collection
    )


    if bevel > 0:

        add_bevel(
            obj,
            bevel,
            2
        )


    return obj


