# 12 - BASIC BOX
# ============================================================

def box(
    name,
    dimensions,
    location,
    mat,
    collection,
    rotation=(0, 0, 0)
):

    bpy.ops.mesh.primitive_cube_add(
        location=location,
        rotation=rotation
    )

    obj = bpy.context.object

    obj.name = name
    obj.dimensions = dimensions


    bpy.ops.object.transform_apply(
        location=False,
        rotation=False,
        scale=True
    )


    if mat:

        obj.data.materials.append(
            mat
        )


    for old in list(
        obj.users_collection
    ):

        old.objects.unlink(
            obj
        )


    collection.objects.link(
        obj
    )


    return obj


# ============================================================
# 13 - PIPE
# ============================================================

def create_pipe(
    name,
    p1,
    p2,
    radius,
    mat
):

    p1 = Vector(p1)
    p2 = Vector(p2)

    direction = (
        p2 - p1
    )

    length = (
        direction.length
    )

    centre = (
        p1 + p2
    ) / 2


    bpy.ops.mesh.primitive_cylinder_add(
        vertices=20,
        radius=radius,
        depth=length,
        location=centre
    )


    obj = bpy.context.object

    obj.name = name


    obj.rotation_euler = (
        direction.to_track_quat(
            'Z',
            'Y'
        ).to_euler()
    )


    obj.data.materials.append(
        mat
    )


    for old in list(
        obj.users_collection
    ):

        old.objects.unlink(
            obj
        )


    COL_SERVICES.objects.link(
        obj
    )


    return obj


# ============================================================
# 14 - SLAB GENERATOR WITH REAL OPENINGS
#
# IMPORTANT:
# This does NOT create slab inside any hole.
# ============================================================

def create_slab(
    name,
    z_top,
    holes,
    mat,
    collection
):

    x_min = (
        -BUILDING_WIDTH / 2
    )

    x_max = (
        BUILDING_WIDTH / 2
    )

    y_min = (
        -BUILDING_DEPTH / 2
    )

    y_max = (
        BUILDING_DEPTH / 2
    )


    xs = [
        x_min,
        x_max
    ]

    ys = [
        y_min,
        y_max
    ]


    valid_holes = []


    for hole in holes:

        hx1, hx2, hy1, hy2 = hole


        hx1 = max(
            hx1,
            x_min
        )

        hx2 = min(
            hx2,
            x_max
        )

        hy1 = max(
            hy1,
            y_min
        )

        hy2 = min(
            hy2,
            y_max
        )


        if (
            hx1 < hx2
            and
            hy1 < hy2
        ):

            valid_holes.append(
                (
                    hx1,
                    hx2,
                    hy1,
                    hy2
                )
            )


            xs.extend(
                [
                    hx1,
                    hx2
                ]
            )


            ys.extend(
                [
                    hy1,
                    hy2
                ]
            )


    xs = sorted(
        set(xs)
    )

    ys = sorted(
        set(ys)
    )


    count = 1


    for i in range(
        len(xs) - 1
    ):

        for j in range(
            len(ys) - 1
        ):

            xa = xs[i]
            xb = xs[i + 1]

            ya = ys[j]
            yb = ys[j + 1]


            if (
                xb - xa < 0.01
                or
                yb - ya < 0.01
            ):

                continue


            cx = (
                xa + xb
            ) / 2

            cy = (
                ya + yb
            ) / 2


            inside_hole = False


            for (
                hx1,
                hx2,
                hy1,
                hy2
            ) in valid_holes:

                if (
                    hx1 < cx < hx2
                    and
                    hy1 < cy < hy2
                ):

                    inside_hole = True

                    break


            if inside_hole:

                continue


            box(
                f"{name}_{count:02d}",

                (
                    xb - xa,
                    yb - ya,
                    SLAB_THICKNESS
                ),

                (
                    cx,
                    cy,
                    z_top
                    - SLAB_THICKNESS / 2
                ),

                mat,
                collection
            )


            count += 1


# ============================================================
# 15 - PROFILE PRISM
# Used for ramp + kerbs
# ============================================================

def create_profile_prism(
    name,
    x_center,
    width,
    stations,
    thickness,
    mat,
    collection
):

    half = (
        width / 2
    )


    verts = []


    # top

    for y, z in stations:

        verts.append(
            (
                x_center - half,
                y,
                z
            )
        )

        verts.append(
            (
                x_center + half,
                y,
                z
            )
        )


    # underside

    for y, z in stations:

        verts.append(
            (
                x_center - half,
                y,
                z - thickness
            )
        )

        verts.append(
            (
                x_center + half,
                y,
                z - thickness
            )
        )


    n = len(stations)

    faces = []


    for i in range(
        n - 1
    ):

        a = i * 2
        b = a + 1

        d = (
            (i + 1) * 2
        )

        c = d + 1


        faces.append(
            (
                a,
                b,
                c,
                d
            )
        )


        ua = n * 2 + a
        ub = n * 2 + b
        uc = n * 2 + c
        ud = n * 2 + d


        faces.append(
            (
                ua,
                ud,
                uc,
                ub
            )
        )


        faces.append(
            (
                a,
                d,
                ud,
                ua
            )
        )


        faces.append(
            (
                b,
                ub,
                uc,
                c
            )
        )


    faces.append(
        (
            0,
            n * 2,
            n * 2 + 1,
            1
        )
    )


    last_left = (
        (n - 1) * 2
    )

    last_right = (
        last_left + 1
    )


    faces.append(
        (
            last_left,
            last_right,
            n * 2 + last_right,
            n * 2 + last_left
        )
    )


    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )


    mesh.from_pydata(
        verts,
        [],
        faces
    )


    mesh.update()


    obj = bpy.data.objects.new(
        name,
        mesh
    )


    collection.objects.link(
        obj
    )


    obj.data.materials.append(
        mat
    )


    return obj


# ============================================================
# 16 - VARIABLE SIDE WALL
# Bottom follows ramp exactly.
# ============================================================

def create_ramp_wall(
    name,
    x_center,
    width,
    stations,
    wall_height,
    mat
):

    half = (
        width / 2
    )


    verts = []


    for y, base_z in stations:

        verts.append(
            (
                x_center - half,
                y,
                base_z
            )
        )

        verts.append(
            (
                x_center + half,
                y,
                base_z
            )
        )


        verts.append(
            (
                x_center - half,
                y,
                base_z + wall_height
            )
        )

        verts.append(
            (
                x_center + half,
                y,
                base_z + wall_height
            )
        )


    faces = []


    n = len(stations)


    for i in range(
        n - 1
    ):

        a = i * 4
        b = (
            (i + 1) * 4
        )


        # outer face

        faces.append(
            (
                a,
                b,
                b + 2,
                a + 2
            )
        )


        # inner face

        faces.append(
            (
                a + 1,
                a + 3,
                b + 3,
                b + 1
            )
        )


        # top

        faces.append(
            (
                a + 2,
                b + 2,
                b + 3,
                a + 3
            )
        )


        # bottom

        faces.append(
            (
                a,
                a + 1,
                b + 1,
                b
            )
        )


    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )


    mesh.from_pydata(
        verts,
        [],
        faces
    )


    mesh.update()


    obj = bpy.data.objects.new(
        name,
        mesh
    )


    COL_RAMP.objects.link(
        obj
    )


    obj.data.materials.append(
        mat
    )


    return obj


