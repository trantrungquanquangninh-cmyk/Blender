# 64 - CONTEXT BUILDING
# ============================================================

def context_building(
    name,
    x,
    y,
    width,
    depth,
    height,
    style="dark"
):

    if style == "dark":

        wall_material = (
            MAT_CONTEXT_DARK
        )

    else:

        wall_material = (
            MAT_CONTEXT_LIGHT
        )


    # mass

    box(
        name + "_Mass",

        (
            width,
            depth,
            height
        ),

        (
            x,
            y,
            height / 2
        ),

        wall_material,
        COL_CONTEXT
    )


    storey_height = 3.5

    storeys = max(
        2,
        int(
            height / storey_height
        )
    )


    # façade toward street

    front_y = (
        y + depth / 2 + 0.03
    )


    for level in range(
        1,
        storeys
    ):

        z = (
            level
            * storey_height
            - 1.45
        )


        if z < 1.0:

            continue


        box(
            name
            + f"_Glass_{level:02d}",

            (
                width - 1.0,
                0.07,
                2.15
            ),

            (
                x,
                front_y,
                z
            ),

            MAT_CONTEXT_GLASS,
            COL_CONTEXT
        )


    # vertical mullions

    count = max(
        3,
        int(
            width / 3.0
        )
    )


    spacing = (
        width / count
    )


    for i in range(
        count + 1
    ):

        mx = (
            x
            - width / 2
            + i * spacing
        )


        box(
            name + "_Mullion",

            (
                0.075,
                0.10,
                height - 1.0
            ),

            (
                mx,
                front_y + 0.02,
                height / 2
            ),

            MAT_ALUMINIUM,
            COL_CONTEXT
        )


    # roof parapet

    box(
        name + "_Parapet",

        (
            width + 0.20,
            depth + 0.20,
            0.55
        ),

        (
            x,
            y,
            height + 0.275
        ),

        wall_material,
        COL_CONTEXT
    )


