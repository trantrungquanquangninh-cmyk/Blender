def create_tree(
    name,
    x,
    y,
    scale=1.0
):

    # pit

    box(
        name + "_Pit",

        (
            1.40 * scale,
            1.40 * scale,
            0.10
        ),

        (
            x,
            y,
            0.07
        ),

        MAT_SOIL,
        COL_LANDSCAPE
    )


    # trunk

    bpy.ops.mesh.primitive_cylinder_add(
        vertices=18,
        radius=0.17 * scale,
        depth=3.5 * scale,

        location=(
            x,
            y,
            1.80 * scale
        )
    )


    trunk = bpy.context.object

    trunk.name = (
        name + "_Trunk"
    )


    trunk.data.materials.append(
        MAT_TREE_TRUNK
    )


    for old in list(
        trunk.users_collection
    ):

        old.objects.unlink(
            trunk
        )


    COL_LANDSCAPE.objects.link(
        trunk
    )


    canopy_data = [

        (
            0,
            0,
            4.0,
            1.55
        ),

        (
            -0.75,
            0.15,
            4.35,
            0.95
        ),

        (
            0.70,
            -0.15,
            4.50,
            1.00
        ),

        (
            0.10,
            0.55,
            4.80,
            0.90
        )
    ]


    for index, (
        ox,
        oy,
        oz,
        radius
    ) in enumerate(
        canopy_data
    ):

        bpy.ops.mesh.primitive_ico_sphere_add(
            subdivisions=2,

            radius=radius * scale,

            location=(
                x + ox * scale,
                y + oy * scale,
                oz * scale
            )
        )


        canopy = (
            bpy.context.object
        )


        canopy.name = (
            name
            + f"_Canopy_{index}"
        )


        canopy.scale = (
            1.0,
            0.90,
            1.08
        )


        canopy.data.materials.append(
            MAT_TREE_LEAF
        )


        for old in list(
            canopy.users_collection
        ):

            old.objects.unlink(
                canopy
            )


        COL_LANDSCAPE.objects.link(
            canopy
        )


