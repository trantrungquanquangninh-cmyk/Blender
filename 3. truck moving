# ============================================================
# 27. PATH TANGENT
# ============================================================

def tangent_at(index):

    frame = frames[index]


    if index == 0:

        next_frame = frames[
            index + 1
        ]


        tangent = (

            PATH[next_frame]
            - PATH[frame]

        )


    elif index == (
        len(frames) - 1
    ):

        previous_frame = frames[
            index - 1
        ]


        tangent = (

            PATH[frame]
            - PATH[previous_frame]

        )


    else:

        previous_frame = frames[
            index - 1
        ]


        next_frame = frames[
            index + 1
        ]


        tangent = (

            PATH[next_frame]
            - PATH[previous_frame]

        )


    if tangent.length < 0.001:

        tangent = Vector(
            (
                1,
                0,
                0
            )
        )


    tangent.normalize()


    return tangent


