# ============================================================
# 30. WHEEL ROTATION + STEERING
# ============================================================

spin_angle = 0.0

previous_position = None

previous_yaw = None


for index, frame in enumerate(
    frames
):

    position = PATH[
        frame
    ]


    forward = tangent_at(
        index
    )


    horizontal = Vector(
        (
            forward.x,
            forward.y,
            0
        )
    )


    if horizontal.length < 0.001:

        horizontal = Vector(
            (
                1,
                0,
                0
            )
        )


    horizontal.normalize()


    yaw = math.atan2(
        horizontal.y,
        horizontal.x
    )


    # ========================================================
    # WHEEL SPIN
    # ========================================================

    if previous_position is not None:

        distance = (

            position
            - previous_position

        ).length


        spin_angle += (
            distance
            / WHEEL_RADIUS
        )


    for wheel in wheels:

        wheel.rotation_mode = (
            'XYZ'
        )


        wheel.rotation_euler.y = (
            spin_angle
        )


        wheel.keyframe_insert(
            data_path="rotation_euler",
            frame=frame,
            index=1
        )


    # ========================================================
    # FRONT STEERING ANGLE
    # ========================================================

    steer_angle = 0.0


    if (
        previous_yaw is not None
        and
        previous_position is not None
    ):

        delta_yaw = (
            yaw
            - previous_yaw
        )


        # normalize to -pi / +pi

        while delta_yaw > math.pi:

            delta_yaw -= (
                2 * math.pi
            )


        while delta_yaw < -math.pi:

            delta_yaw += (
                2 * math.pi
            )


        distance = max(
            (
                position
                - previous_position
            ).length,
            0.01
        )


        curvature = (
            delta_yaw
            / distance
        )


        steer_angle = math.atan(
            WHEELBASE
            * curvature
        )


        max_steer = math.radians(
            28
        )


        steer_angle = max(
            -max_steer,
            min(
                max_steer,
                steer_angle
            )
        )


    steer_fl.rotation_euler.z = (
        steer_angle
    )


    steer_fr.rotation_euler.z = (
        steer_angle
    )


    steer_fl.keyframe_insert(
        data_path="rotation_euler",
        frame=frame,
        index=2
    )


    steer_fr.keyframe_insert(
        data_path="rotation_euler",
        frame=frame,
        index=2
    )


    previous_position = (
        position.copy()
    )


    previous_yaw = (
        yaw
    )


