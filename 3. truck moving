PATH = {}


def add_line(
    frame_start,
    frame_end,
    point_start,
    point_end
):

    p0 = Vector(point_start)
    p1 = Vector(point_end)


    for frame in range(
        frame_start,
        frame_end + 1,
        BAKE_STEP
    ):

        if frame_end == frame_start:

            t = 0

        else:

            t = (
                frame - frame_start
            ) / (
                frame_end - frame_start
            )


        t = max(
            0.0,
            min(
                1.0,
                t
            )
        )


        PATH[frame] = (
            p0.lerp(
                p1,
                t
            )
        )


    PATH[frame_end] = (
        p1.copy()
    )


def bezier_point(
    p0,
    p1,
    p2,
    p3,
    t
):

    u = (
        1.0 - t
    )


    return (

        (u ** 3) * p0

        + 3
        * (u ** 2)
        * t
        * p1

        + 3
        * u
        * (t ** 2)
        * p2

        + (t ** 3)
        * p3

    )


def add_bezier(
    frame_start,
    frame_end,
    p0,
    p1,
    p2,
    p3
):

    p0 = Vector(p0)
    p1 = Vector(p1)
    p2 = Vector(p2)
    p3 = Vector(p3)


    for frame in range(
        frame_start,
        frame_end + 1,
        BAKE_STEP
    ):

        t = (
            frame - frame_start
        ) / (
            frame_end - frame_start
        )


        t = max(
            0.0,
            min(
                1.0,
                t
            )
        )


        PATH[frame] = bezier_point(
            p0,
            p1,
            p2,
            p3,
            t
        )


    PATH[frame_end] = (
        p3.copy()
    )


