    Vector(
        (
            -2.80,
            0,
            1.45
        )
    ),

    Vector(
        (
            0,
            0,
            2.75
        )
    ),

    Vector(
        (
            0,
            0,
            0.65
        )
    )

]


def visibility_score(
    camera_position
):

    score = 0


    truck_world = (
        truck.matrix_world
    )


    for local_point in (
        TRUCK_CHECK_POINTS
    ):

        target = (
            truck_world
            @ local_point
        )


        if ray_visible(
            camera_position,
            target
        ):

            score += 1


    return score


# ============================================================
# 37. GENERATE CAMERA CANDIDATES
# ============================================================

WORLD_UP = Vector(
    (
        0,
        0,
        1
    )
)


def camera_candidates(
    frame,
    truck_position,
    forward
):

    side = (
        forward.cross(
            WORLD_UP
        )
    )


    if side.length < 0.001:

        side = Vector(
            (
                0,
                -1,
                0
            )
        )


    side.normalize()


    horizontal_forward = Vector(
        (
            forward.x,
            forward.y,
            0
        )
    )


    if horizontal_forward.length < 0.001:

        horizontal_forward = Vector(
            (
                1,
                0,
                0
            )
        )


    horizontal_forward.normalize()


    candidates = []


    # ========================================================
    # ROAD
    #
    # Rear three-quarter
    # ========================================================

    if frame <= F_TURN_END:

        candidates = [

            truck_position
            - horizontal_forward
            * ROAD_BACK
            + side
            * ROAD_SIDE
            + WORLD_UP
            * ROAD_HEIGHT,

            truck_position
            - horizontal_forward
            * ROAD_BACK
            - side
            * ROAD_SIDE
            + WORLD_UP
            * ROAD_HEIGHT,

            truck_position
            - horizontal_forward
            * 7.0
            + side
            * 9.0
            + WORLD_UP
            * 4.8,

            truck_position
            - horizontal_forward
            * 7.0
            - side
            * 9.0
            + WORLD_UP
            * 4.8

        ]


    # ========================================================
    # GARAGE APPROACH
    #
    # Front/side view to clearly show entrance.
    # ========================================================

    elif frame <= F_RAMP_START:

        candidates = [

            truck_position
            + horizontal_forward
            * APPROACH_DISTANCE
            + side
            * APPROACH_SIDE
            + WORLD_UP
            * APPROACH_HEIGHT,

            truck_position
            + horizontal_forward
            * APPROACH_DISTANCE
            - side
            * APPROACH_SIDE
            + WORLD_UP
            * APPROACH_HEIGHT,

            truck_position
            - horizontal_forward
            * 8.0
            + side
            * 5.0
            + WORLD_UP
            * 4.0,

            truck_position
            - horizontal_forward
            * 8.0
            - side
            * 5.0
            + WORLD_UP
            * 4.0

        ]


    # ========================================================
    # RAMP
    #
    # Camera primarily travels AHEAD of vehicle.
    #
    # Because Building V4 has an OPEN ramp void,
    # this gives a clean view down the ramp.
    # ========================================================

    elif frame <= F_RAMP_END:

        candidates = [

            truck_position
            + horizontal_forward
            * RAMP_DISTANCE
            + side
            * RAMP_SIDE
            + WORLD_UP
            * RAMP_HEIGHT,

            truck_position
            + horizontal_forward
            * RAMP_DISTANCE
            - side
            * RAMP_SIDE
            + WORLD_UP
            * RAMP_HEIGHT,

            truck_position
            - horizontal_forward
            * 7.0
            + side
            * 4.0
            + WORLD_UP
            * 3.0,

            truck_position
            - horizontal_forward
            * 7.0
            - side
            * 4.0
            + WORLD_UP
            * 3.0

        ]


    # ========================================================
    # BASEMENT
    #
    # Lower camera so it stays below slab soffit.
    # ========================================================

    else:

        candidates = [

            truck_position
            + horizontal_forward
            * B1_DISTANCE
            + side
            * B1_SIDE
            + WORLD_UP
            * B1_HEIGHT,

            truck_position
            + horizontal_forward
            * B1_DISTANCE
            - side
            * B1_SIDE
            + WORLD_UP
            * B1_HEIGHT,

            truck_position
            - horizontal_forward
            * 7.0
            + side
            * 4.0
            + WORLD_UP
            * 2.0,

            truck_position
            - horizontal_forward
            * 7.0
            - side
            * 4.0
            + WORLD_UP
            * 2.0,

            truck_position
            + side
            * 8.0
            + WORLD_UP
            * 2.0,

            truck_position
            - side
            * 8.0
            + WORLD_UP
            * 2.0

        ]


    return candidates


# ============================================================
# 38. CAMERA BAKE
# ============================================================

previous_camera_position = None


for frame in range(
    F_START,
    F_END + 1,
    BAKE_STEP
):

    scene.frame_set(
        frame
    )


    bpy.context.view_layer.update()


    truck_position = (
        truck.matrix_world.translation.copy()
    )


    truck_rotation = (
        truck.matrix_world.to_quaternion()
    )


    forward = (

        truck_rotation

        @ Vector(
            (
                1,
                0,
                0
            )
        )
    )


    forward.normalize()


    candidates = camera_candidates(
        frame,
        truck_position,
        forward
    )


    best_candidate = None

    best_score = (
        -999999.0
    )


    # ========================================================
    # Test each camera position.
    #
    # Visibility is highest priority.
    # Continuity prevents camera jumping unnecessarily.
    # ========================================================

    for candidate in candidates:

        visible = visibility_score(
            candidate
        )


        score = (
            visible * 100.0
        )


        if previous_camera_position is not None:

            camera_move = (

                candidate
                - previous_camera_position

            ).length


            score -= (
                camera_move * 0.25
            )


        if score > best_score:

            best_score = score

            best_candidate = (
                candidate.copy()
            )


    # fallback

    if best_candidate is None:

        best_candidate = (
            candidates[0].copy()
        )


    previous_camera_position = (
        best_candidate.copy()
    )


    # ========================================================
    # CAMERA TARGET
    # ========================================================

    target_position = (

        truck_position

        + Vector(
            (
                0,
                0,
                1.35
            )
        )
    )


    # Slightly favour truck centre/front on the road

    if frame <= F_RAMP_START:

        target_position += (
            forward * 0.45
        )


    # ========================================================
    # CAMERA ORIENTATION
    # ========================================================

    direction = (

        target_position
        - best_candidate

    )


    camera.location = (
        best_candidate
    )


    camera.rotation_quaternion = (

        direction.to_track_quat(
            '-Z',
            'Y'
        )
    )


    camera_target.location = (
        target_position
    )


    # ========================================================
    # LENS BY PHASE
    # ========================================================

    if frame <= F_ROAD_END:

        camera.data.lens = 38


    elif frame <= F_RAMP_START:

        camera.data.lens = 34


    elif frame <= F_RAMP_END:

        camera.data.lens = 30


    else:

        camera.data.lens = 27


    camera.keyframe_insert(
        data_path="location",
        frame=frame
    )


    camera.keyframe_insert(
        data_path="rotation_quaternion",
        frame=frame
    )


    camera.data.keyframe_insert(
        data_path="lens",
        frame=frame
    )


# ============================================================
# 39. HOLD CAMERA AT END
# ============================================================

scene.frame_set(
    F_END
)


bpy.context.view_layer.update()


# ============================================================
# 40. CAMERA INTERPOLATION
#
# Dense LINEAR bake prevents camera from Bezier-curving
# into walls or columns.
# ============================================================

if camera.animation_data:

    action = (
        camera.animation_data.action
    )


    if action:

        for curve in action.fcurves:

            for key in curve.keyframe_points:

                key.interpolation = (
                    'LINEAR'
                )


if camera.data.animation_data:

    action = (
        camera.data.animation_data.action
    )


    if action:

        for curve in action.fcurves:

