def belongs_to_truck(obj):

    current = obj


    while current is not None:

        if current == truck:

            return True


        current = current.parent


    return False


# ============================================================
# 35. RAY CAST VISIBILITY TEST
# ============================================================

depsgraph = bpy.context.evaluated_depsgraph_get()


def ray_visible(
    camera_position,
    target_position
):

    direction = (
        target_position
        - camera_position
    )


    distance = (
        direction.length
    )


    if distance < 0.01:

        return True


    direction.normalize()


    result = scene.ray_cast(

        depsgraph,

        camera_position,

        direction,

        distance=distance + 0.15

    )


    hit = result[0]


    if not hit:

        return True


    hit_object = result[4]


    if hit_object is None:

        return True


    if belongs_to_truck(
        hit_object
    ):

        return True


    return False


