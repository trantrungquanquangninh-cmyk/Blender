    (
        0,
        0,
        1
    )
)


for frame in range(
    FRAME_START,
    FRAME_END + 1,
    CAMERA_BAKE_STEP
):

    scene.frame_set(
        frame
    )

    bpy.context.view_layer.update()


    truck_position = (
        TRUCK.matrix_world.translation.copy()
    )


    forward = (
        TRUCK.matrix_world.to_3x3()
        @ Vector(
            (
                1,
                0,
                0
            )
        )
    )


    if forward.length < 0.001:

        forward = Vector(
            (
                1,
                0,
                0
            )
        )


    forward.normalize()


    forward_flat = Vector(
        (
            forward.x,
            forward.y,
            0
        )
    )


    if forward_flat.length < 0.001:

        forward_flat = Vector(
            (
                1,
                0,
                0
            )
        )


    forward_flat.normalize()


    side = (
        forward_flat.cross(
            WORLD_UP
        )
    )


    side.normalize()


    camera_position = (

        truck_position

        - forward_flat
        * CAMERA_BACK

        + side
        * CAMERA_SIDE

        + WORLD_UP
        * CAMERA_HEIGHT
    )


    target_position = (

        truck_position

        + forward
        * CAMERA_LOOK_AHEAD

        + WORLD_UP
        * CAMERA_TARGET_HEIGHT
    )


    CAMERA.location = (
        camera_position
    )


    TARGET.location = (
        target_position
    )


    direction = (
        target_position
        - camera_position
    )


    CAMERA.rotation_quaternion = (
        direction.to_track_quat(
            '-Z',
            'Y'
        )
    )


    CAMERA.keyframe_insert(
        data_path="location",
        frame=frame
    )


    CAMERA.keyframe_insert(
        data_path="rotation_quaternion",
        frame=frame
    )


