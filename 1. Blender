# ============================================================
# CALCULATE VEHICLE ROTATIONS
# ============================================================

positions = [
    Vector(item[1])
    for item in WAYPOINTS
]


frames = [
    item[0]
    for item in WAYPOINTS
]


yaws = []
pitches = []


for i in range(
    len(positions)
):


    if i == 0:

        tangent = (
            positions[1]
            - positions[0]
        )


    elif i == len(positions) - 1:

        tangent = (
            positions[-1]
            - positions[-2]
        )


    else:

        tangent = (
            positions[i + 1]
            - positions[i - 1]
        )


    horizontal = math.sqrt(
        tangent.x ** 2
        + tangent.y ** 2
    )


    yaw = math.atan2(
        tangent.y,
        tangent.x
    )


    pitch = -math.atan2(
        tangent.z,
        horizontal
    )


    yaws.append(
        yaw
    )

    pitches.append(
        pitch
    )


# ============================================================
# UNWRAP YAW
# Prevent 360-degree rotation.
# ============================================================

for i in range(
    1,
    len(yaws)
):

    while (
        yaws[i]
        - yaws[i - 1]
        > math.pi
    ):

        yaws[i] -= (
            2 * math.pi
        )


    while (
        yaws[i]
        - yaws[i - 1]
        < -math.pi
    ):

        yaws[i] += (
            2 * math.pi
        )


# ============================================================
# INSERT TRUCK KEYS
# ============================================================

TRUCK.rotation_mode = 'XYZ'


for i in range(
    len(WAYPOINTS)
):

    frame = frames[i]

    TRUCK.location = (
        positions[i]
    )


    TRUCK.rotation_euler = (

        0,

        pitches[i],

        yaws[i]
    )


    TRUCK.keyframe_insert(
        data_path="location",
        frame=frame
    )


    TRUCK.keyframe_insert(
        data_path="rotation_euler",
        frame=frame
    )


