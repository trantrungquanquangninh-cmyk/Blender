# ============================================================
# BASIC FUNCTIONS
# ============================================================

def move_to_collection(
    obj,
    collection
):

    for old in list(obj.users_collection):

        old.objects.unlink(obj)

    collection.objects.link(obj)


def box(
    name,
    dimensions,
    location,
    material,
    collection,
    rotation=(0, 0, 0),
    parent=None
):

    bpy.ops.mesh.primitive_cube_add(
        location=location,
        rotation=rotation
    )

    obj = bpy.context.object

    obj.name = name

    obj.dimensions = dimensions

    bpy.ops.object.transform_apply(
        location=False,
        rotation=False,
        scale=True
    )

    if material:

        obj.data.materials.append(
            material
        )

    move_to_collection(
        obj,
        collection
    )

    if parent:

        obj.parent = parent

    return obj


# ============================================================
# BEAM BETWEEN TWO POINTS
# ============================================================

def beam_between(
    name,
    p1,
    p2,
    width,
    height,
    material,
    collection,
    parent=None
):

    p1 = Vector(p1)
    p2 = Vector(p2)

    direction = p2 - p1

    length = direction.length

    centre = (
        p1 + p2
    ) / 2


    obj = box(
        name,
        (
            length,
            width,
            height
        ),
        centre,
        material,
        collection,
        parent=parent
    )


    obj.rotation_mode = 'QUATERNION'

    obj.rotation_quaternion = (
        direction.to_track_quat(
            'X',
            'Z'
        )
    )


    return obj


# ============================================================
# PIPE
# ============================================================

def create_pipe(
    name,
    p1,
    p2,
    radius,
    material
):

    p1 = Vector(p1)
    p2 = Vector(p2)

    direction = (
        p2 - p1
    )

    length = (
        direction.length
    )

    centre = (
        p1 + p2
    ) / 2


    bpy.ops.mesh.primitive_cylinder_add(
        vertices=20,
        radius=radius,
        depth=length,
        location=centre
    )


    obj = bpy.context.object

    obj.name = name

    obj.rotation_euler = (
        direction.to_track_quat(
            'Z',
            'Y'
        ).to_euler()
    )


    obj.data.materials.append(
        material
    )


    move_to_collection(
        obj,
        COL_SERVICES
    )


# ============================================================
# SLOPED PRISM
# Proper ramp mesh.
# ============================================================

def sloped_prism(
    name,
    x_center,
    width,
    y_start,
    y_end,
    z_start,
    z_end,
    thickness,
    material,
    collection
):

    x1 = (
        x_center
        - width / 2
    )

    x2 = (
        x_center
        + width / 2
    )


    verts = [

        (
            x1,
            y_start,
            z_start
        ),

        (
            x2,
            y_start,
            z_start
        ),

        (
            x2,
            y_end,
            z_end
        ),

        (
            x1,
            y_end,
            z_end
        ),

        (
            x1,
            y_start,
            z_start - thickness
        ),

        (
            x2,
            y_start,
            z_start - thickness
        ),

        (
            x2,
            y_end,
            z_end - thickness
        ),

        (
            x1,
            y_end,
            z_end - thickness
        )
    ]


    faces = [

        (0, 1, 2, 3),

        (4, 7, 6, 5),

        (0, 4, 5, 1),

        (1, 5, 6, 2),

        (2, 6, 7, 3),

        (3, 7, 4, 0)
    ]


    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )

    mesh.from_pydata(
        verts,
        [],
        faces
    )

    mesh.update()


    obj = bpy.data.objects.new(
        name,
        mesh
    )

    collection.objects.link(
        obj
    )

    obj.data.materials.append(
        material
    )


    return obj


# ============================================================
# CLEAN SLAB WITH RECTANGULAR OPENINGS
# NO BOOLEAN
# ============================================================

def create_slab(
    name,
    z_top,
    holes,
    material,
    collection
):

    x_min = (
        -BUILDING_WIDTH / 2
    )

    x_max = (
        BUILDING_WIDTH / 2
    )

    y_min = (
        -BUILDING_DEPTH / 2
    )

    y_max = (
        BUILDING_DEPTH / 2
    )


    xs = [
        x_min,
        x_max
    ]

    ys = [
        y_min,
        y_max
    ]


    valid_holes = []


    for hole in holes:

        hx1, hx2, hy1, hy2 = hole

        hx1 = max(
            hx1,
            x_min
        )

        hx2 = min(
            hx2,
            x_max
        )

        hy1 = max(
            hy1,
            y_min
        )

        hy2 = min(
            hy2,
            y_max
        )


        if (
            hx1 < hx2
            and
            hy1 < hy2
        ):

            valid_holes.append(
                (
                    hx1,
                    hx2,
                    hy1,
                    hy2
                )
            )

            xs.extend(
                [
                    hx1,
                    hx2
                ]
            )

            ys.extend(
                [
                    hy1,
                    hy2
                ]
            )


    xs = sorted(
        set(xs)
    )

    ys = sorted(
        set(ys)
    )


    counter = 1


    for i in range(
        len(xs) - 1
    ):

        for j in range(
            len(ys) - 1
        ):


            xa = xs[i]
            xb = xs[i + 1]

            ya = ys[j]
            yb = ys[j + 1]


            if (
                xb - xa < 0.01
                or
                yb - ya < 0.01
            ):

                continue


            cx = (
                xa + xb
            ) / 2

            cy = (
                ya + yb
            ) / 2


            inside = False


            for (
                hx1,
                hx2,
                hy1,
                hy2
            ) in valid_holes:


                if (
                    hx1 < cx < hx2
                    and
                    hy1 < cy < hy2
                ):

                    inside = True

                    break


            if inside:

                continue


            box(
                f"{name}_{counter:02d}",

                (
                    xb - xa,
                    yb - ya,
                    SLAB_THICKNESS
                ),

                (
                    cx,
                    cy,
                    z_top
                    - SLAB_THICKNESS / 2
                ),

                material,
                collection
            )


            counter += 1


