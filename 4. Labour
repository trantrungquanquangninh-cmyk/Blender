def route_yaw(
    current,
    next_position
):

    direction = (

        Vector(
            next_position
        )

        - Vector(
            current
        )

    )


    direction.z = 0


    if direction.length < 0.01:

        return 0.0


    return math.atan2(
        direction.y,
        direction.x
    )


def quaternion_from_yaw(
    yaw
):

    direction = Vector(
        (
            math.cos(yaw),
            math.sin(yaw),
            0
        )
    )


    return direction.to_track_quat(
        'X',
        'Z'
    )


def animate_route(
    obj,
    route
):

    previous_yaw = 0.0


    for i, (
        frame,
        position
    ) in enumerate(
        route
    ):

        if i < (
            len(route) - 1
        ):

            yaw = route_yaw(
                position,
                route[
                    i + 1
                ][1]
            )


            previous_yaw = yaw


        else:

            yaw = (
                previous_yaw
            )


        key_location(
            obj,
            frame,
            position
        )


        key_rotation_z(
            obj,
            frame,
            yaw
        )


    make_linear(
        obj
    )


