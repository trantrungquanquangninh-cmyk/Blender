def walk_cycle(
    worker,
    start_frame,
    end_frame,
    step=8
):

    parts = [

        worker["leg_l"],
        worker["leg_r"],
        worker["arm_l"],
        worker["arm_r"]

    ]


    sign = 1


    for frame in range(
        start_frame,
        end_frame + 1,
        step
    ):

        angle = (

            math.radians(
                16
            )

            * sign

        )


        worker[
            "leg_l"
        ].rotation_euler.y = (
            angle
        )


        worker[
            "leg_r"
        ].rotation_euler.y = (
            -angle
        )


        worker[
            "arm_l"
        ].rotation_euler.y = (
            -angle * 0.70
        )


        worker[
            "arm_r"
        ].rotation_euler.y = (
            angle * 0.70
        )


        for part in parts:

            part.keyframe_insert(
                data_path="rotation_euler",
                frame=frame
            )


        sign *= -1


