def remove_keys_after(
    obj,
    frame
):

    if obj is None:

        return


    if obj.animation_data is None:

        return


    action = (
        obj.animation_data.action
    )


    if action is None:

        return


    try:

        curves = action.fcurves

    except:

        return


    for curve in curves:

        remove_points = [

            key

            for key
            in curve.keyframe_points

            if key.co.x >= frame

        ]


        for key in remove_points:

            curve.keyframe_points.remove(
                key
            )


