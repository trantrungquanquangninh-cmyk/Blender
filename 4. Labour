# ============================================================
# 23. INTERPOLATION
# ============================================================

def make_linear(
    obj
):

    if obj is None:

        return


    if obj.animation_data is None:

        return


    action = (
        obj.animation_data.action
    )


    if action is None:

        return


    try:

        curves = action.fcurves

    except:

        return


    for curve in curves:

        for key in curve.keyframe_points:

            key.interpolation = (
                'LINEAR'
            )


def make_scale_smooth(
    obj
):

    if obj.animation_data is None:

        return


    action = (
        obj.animation_data.action
    )


    if action is None:

        return


    try:

        curves = action.fcurves

    except:

        return


    for curve in curves:

        if curve.data_path != "scale":

            continue


        for key in curve.keyframe_points:

            key.interpolation = (
                'BEZIER'
            )


            try:

                key.handle_left_type = (
                    'AUTO_CLAMPED'
                )

                key.handle_right_type = (
                    'AUTO_CLAMPED'
                )

            except:

                pass


# ============================================================
# 24. GET DESCENDANTS
# ============================================================

def descendants(
    parent
):

    result = []


    def recurse(
        obj
    ):

        for child in obj.children:

            result.append(
                child
            )


            recurse(
                child
            )


    recurse(
        parent
    )


    return result


