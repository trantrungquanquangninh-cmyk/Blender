def look_at(
    camera_obj,
    position,
    target
):

    position = Vector(
        position
    )


    target = Vector(
        target
    )


    camera_obj.location = (
        position
    )


    direction = (

        target

        - position

    )


    if direction.length < 0.001:

        return


    camera_obj.rotation_quaternion = (

        direction.to_track_quat(
            '-Z',
            'Y'
        )

    )


