def animate_door_pair(
    doors,
    originals,
    sequences
):

    center_x = (

        sum(

            originals[
                obj.name
            ].x

            for obj in doors

        )

        / len(
            doors
        )

    )


    for obj in doors:

        closed_position = (
            originals[
                obj.name
            ].copy()
        )


        if closed_position.x < center_x:

            direction = -1

        else:

            direction = 1


        opened_position = (
            closed_position.copy()
        )


        opened_position.x += (
            direction * 0.57
        )


        for (
            frame_closed,
            frame_open,
            frame_close_start,
            frame_closed_end
        ) in sequences:

            key_location(
                obj,
                frame_closed,
                closed_position
            )


            key_location(
                obj,
                frame_open,
                opened_position
            )


            key_location(
                obj,
                frame_close_start,
                opened_position
            )


            key_location(
                obj,
                frame_closed_end,
                closed_position
            )


        make_linear(
            obj
        )


