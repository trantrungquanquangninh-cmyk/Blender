def create_worker_route(
    lateral,
    longitudinal
):

    result = []


    for index, (
        frame,
        position
    ) in enumerate(
        WORKER_ROUTE
    ):

        position = Vector(
            position
        )


        if index < (
            len(WORKER_ROUTE) - 1
        ):

            next_position = Vector(

                WORKER_ROUTE[
                    index + 1
                ][1]

            )


            forward = (

                next_position

                - position

            )


            forward.z = 0


        else:

            forward = (
                FORWARD.copy()
            )


        if forward.length < 0.05:

            forward = (
                FORWARD.copy()
            )


        forward.normalize()


        side = Vector(
            (
                -forward.y,
                forward.x,
                0
            )
        )


        # workers move closer together inside lift

        inside_lift = (

            F_ENTER_LIFT
            <= frame
            <= F_EXIT_LIFT

        ) or (

            F_RETURN_ENTER_LIFT
            <= frame
            <= F_EXIT_B1

        )


        if inside_lift:

            current_lateral = (
                lateral * 0.42
            )

            current_longitudinal = (
                longitudinal * 0.45
            )

        else:

            current_lateral = (
                lateral
            )

            current_longitudinal = (
                longitudinal
            )


        worker_position = (

            position

            + side
            * current_lateral

            + forward
            * current_longitudinal

        )


        result.append(
            (
                frame,
                worker_position
            )
        )


    return result


